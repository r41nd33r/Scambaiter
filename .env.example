# --- LLM (Featherless is OpenAI-compatible) ---
# Leave LLM_API_KEY empty to run in offline fallback mode (rule-based, no AI calls).
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# Minimum confidence before the bot engages a message.
SCAM_THRESHOLD=0.7

# --- Inbox ---
# manual = paste scams into the dashboard and copy replies out yourself (safest, default)
# imap   = poll a dedicated burner inbox over IMAP and reply over SMTP
INBOX_MODE=manual
# In imap mode, only auto-reply above this confidence; anything lower waits for approval.
AUTO_SEND_THRESHOLD=0.85
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
POLL_SECONDS=60
